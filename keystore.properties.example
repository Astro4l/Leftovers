# Copy to keystore.properties (git-ignored) to sign release builds locally.
# Create a keystore once with:
#   keytool -genkeypair -v -keystore release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias leftovers
storeFile=release.jks
storePassword=change-me
keyAlias=leftovers
keyPassword=change-me

# Optional: a SEPARATE key for Leftovers Dev builds. Never reuse the release key for these.
# devStoreFile=dev.jks
# devStorePassword=change-me
# devKeyAlias=leftovers-dev
# devKeyPassword=change-me
